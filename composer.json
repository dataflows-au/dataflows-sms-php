{
    "name": "dataflows-au/dataflows-sms",
    "description": "Official PHP client for the DataFlows SMS API",
    "keywords": ["sms", "dataflows", "text message", "australia", "api"],
    "homepage": "https://dataflows.com.au/developers",
    "type": "library",
    "license": "MIT",
    "authors": [
        { "name": "DataFlows Australia Pty Ltd", "email": "support@dataflows.com.au" }
    ],
    "support": {
        "email": "support@dataflows.com.au",
        "docs": "https://docs.dataflows.com.au/"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": { "DataFlows\\Sms\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "DataFlows\\Sms\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    }
}
