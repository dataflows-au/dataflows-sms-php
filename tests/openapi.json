    "/sms/send": {
      "post": {
        "operationId": "sendSms",
        "tags": [
          "SMS"
        ],
        "summary": "Send an SMS",
        "description": "One number is queued and returns a single result in `data`. Several numbers are sent during the request and return a list with one entry per number. Trial accounts can only send to numbers they have verified.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "recipient",
                  "sender_id",
                  "message"
                ],
                "properties": {
                  "recipient": {
                    "type": "string",
                    "description": "One number in international format, or several separated by commas.",
                    "example": "61404235133"
                  },
                  "sender_id": {
                    "type": "string",
                    "description": "One of your active sender IDs or numbers. See `GET /sender-ids`.",
                    "example": "YOUR_SENDER_ID"
                  },
                  "message": {
                    "type": "string",
                    "example": "Hello from DataFlows"
                  },
                  "schedule_time": {
                    "type": "string",
                    "description": "Send later, as `Y-m-d H:i` in your account's timezone. Leave it out to send now.",
                    "example": "2030-01-31 09:00"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "recipient",
                  "sender_id",
                  "message"
                ],
                "properties": {
                  "recipient": {
                    "type": "string",
                    "description": "One number in international format, or several separated by commas.",
                    "example": "61404235133"
                  },
                  "sender_id": {
                    "type": "string",
                    "description": "One of your active sender IDs or numbers. See `GET /sender-ids`.",
                    "example": "YOUR_SENDER_ID"
                  },
                  "message": {
                    "type": "string",
                    "example": "Hello from DataFlows"
                  },
                  "schedule_time": {
                    "type": "string",
                    "description": "Send later, as `Y-m-d H:i` in your account's timezone. Leave it out to send now.",
                    "example": "2030-01-31 09:00"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The message was accepted. Most errors also answer HTTP 200, so check the `status` field.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/SendResponse"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "The sender ID isn't one you can use, or another send check failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/sms": {
      "get": {
        "operationId": "listMessages",
        "tags": [
          "SMS"
