{
  "openapi": "3.0.3",
  "info": {
    "title": "DataFlows SMS API",
    "version": "1.0.0",
    "description": "Send SMS, check delivery and manage contacts.\n\n**Log in** with your API token as a Bearer header. Find it in your account under Developers.\n\n**Send JSON** with `Content-Type: application/json`. Form posts also work.\n\n**Check the `status` field.** Many errors answer HTTP 200 with `\"status\": \"error\"`, so the HTTP code alone isn't enough.\n\n**Limit:** 600 requests per minute per token. Past that, the API answers HTTP 429.",
    "contact": {
      "name": "DataFlows Support",
      "email": "support@dataflows.com.au",
      "url": "https://dataflows.com.au/developers"
    },
    "termsOfService": "https://dataflows.com.au/terms-of-use"
  },
  "externalDocs": {
    "description": "Full guides",
    "url": "https://docs.dataflows.com.au/"
  },
  "servers": [
    {
      "url": "https://sms.dataflows.com.au/api/http"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Account"
    },
    {
      "name": "SMS"
    },
    {
      "name": "Contact groups"
    },
    {
      "name": "Contacts"
    }
  ],
