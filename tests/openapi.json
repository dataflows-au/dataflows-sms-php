    },
    "responses": {
      "Forbidden": {
        "description": "Your account doesn't have API access, or is disabled.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Not found. Records belonging to another account also answer this.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "ValidationFailed": {
        "description": "A field is missing or invalid.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                },
                "errors": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "More than 600 requests in a minute with this token.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Success": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success"
            ]
          },
          "message": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "status",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "error"
            ]
          },
          "message": {
            "type": "string",
            "example": "These credentials do not match our records."
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "current_page",
          "last_page",
          "per_page",
          "total"
        ],
        "properties": {
          "current_page": {
            "type": "integer"
          },
          "first_page_url": {
            "type": "string"
          },
          "from": {
            "type": "integer",
            "nullable": true
          },
          "last_page": {
            "type": "integer"
          },
          "last_page_url": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "nullable": true
                },
                "label": {
                  "type": "string"
                },
                "active": {
                  "type": "boolean"
                }
              }
            }
          },
          "next_page_url": {
            "type": "string",
            "nullable": true
          },
          "path": {
            "type": "string"
          },
          "per_page": {
            "type": "integer"
          },
          "prev_page_url": {
            "type": "string",
            "nullable": true
          },
          "to": {
            "type": "integer",
            "nullable": true
          },
          "total": {
            "type": "integer"
          }
        }
      },
      "Profile": {
        "type": "object",
        "required": [
          "uid",
          "email"
        ],
        "properties": {
          "uid": {
            "type": "string"
          },
          "api_token": {
            "type": "string"
          },
          "first_name": {
            "type": "string",
            "nullable": true
          },
          "last_name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          },
          "last_access_at": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Balance": {
        "type": "object",
        "required": [
          "remaining_balance",
          "expired_on"
        ],
        "properties": {
          "remaining_balance": {
            "type": "string",
            "description": "Credits left, formatted for display."
          },
          "expired_on": {
            "type": "string",
            "description": "When the current plan period ends, formatted for display in the account's timezone."
          }
        }
      },
      "SenderIds": {
        "type": "object",
        "required": [
          "value"
        ],
        "properties": {
          "value": {
            "type": "array",
            "description": "Active sender IDs on the account.",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "SendResult": {
        "type": "object",
        "required": [
          "campaign_id"
        ],
        "properties": {
          "campaign_id": {
            "type": "string",
            "description": "Identifier for this send."
          },
          "recipient": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "cost": {
            "type": "number",
            "description": "Credits used."
          },
          "sms_count": {
            "type": "integer",
            "description": "How many SMS parts the message takes."
          },
          "status": {
            "type": "string",
            "description": "The message has been accepted and queued. Use the sent messages endpoints for its later status."
          }
        }
      },
      "Message": {
        "type": "object",
        "required": [
          "uid",
          "to"
        ],
        "properties": {
          "uid": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "from": {
            "type": "string",
            "nullable": true
          },
          "message": {
            "type": "string"
          },
          "customer_status": {
            "type": "string",
            "nullable": true,
            "description": "The latest status we hold for this message."
          },
          "cost": {
            "type": "string",
            "nullable": true,
            "description": "Credits used."
          }
        }
      },
      "Group": {
        "type": "object",
        "required": [
          "uid",
          "name"
        ],
        "properties": {
          "uid": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Contact": {
        "type": "object",
        "required": [
          "uid",
          "phone",
          "status"
        ],
        "properties": {
          "uid": {
            "type": "string"
          },
          "phone": {
            "type": "integer",
            "format": "int64",
            "example": 61404235133
          },
          "status": {
            "type": "string",
            "example": "subscribe",
            "description": "`subscribe` or `unsubscribe`."
          },
          "custom_fields": {
            "type": "object",
            "description": "The group's fields by tag, such as FIRST_NAME and LAST_NAME.",
            "additionalProperties": {
              "type": "string",
              "nullable": true
            }
          }
        }
      },
      "ContactInput": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "description": "Any custom field the group has, by its tag."
        },
        "properties": {
          "PHONE": {
            "type": "string",
            "description": "Number in international format.",
            "example": "61404235133"
          },
          "FIRST_NAME": {
            "type": "string",
            "example": "Jane"
          },
          "LAST_NAME": {
            "type": "string",
            "example": "Smith"
          }
        }
      },
      "ProfileResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Success"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/Profile"
              }
            }
          }
        ]
      },
      "BalanceResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Success"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/Balance"
              }
            }
          }
        ]
      },
      "BulkSendResult": {
        "type": "array",
        "description": "One entry per number, when `recipient` holds several.",
        "items": {
          "type": "object",
          "required": [
            "uid",
            "to"
          ],
          "properties": {
            "uid": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "from": {
              "type": "string",
              "nullable": true
            },
            "message": {
              "type": "string"
            },
            "customer_status": {
              "type": "string",
              "nullable": true
            },
            "cost": {
              "type": "string",
              "nullable": true
            },
            "sms_count": {
              "type": "integer"
            }
          }
        }
      },
      "SendResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Success"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/SendResult"
                  },
                  {
                    "$ref": "#/components/schemas/BulkSendResult"
                  }
                ]
              }
            }
          }
        ]
      },
      "MessageResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Success"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/Message"
              }
            }
          }
        ]
      },
      "GroupResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Success"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/Group"
              }
            }
          }
        ]
      },
      "ContactResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Success"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/components/schemas/Contact"
              }
            }
          }
        ]
      },
      "EmptyResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Success"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "nullable": true,
                "type": "object"
              }
            }
          }
        ]
      },
      "MessagePage": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Success"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Pagination"
                  },
                  {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Message"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "GroupPage": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Success"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Pagination"
                  },
                  {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Group"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      },
      "ContactPage": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Success"
          },
          {
            "type": "object",
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/Pagination"
                  },
                  {
                    "type": "object",
                    "required": [
                      "data"
                    ],
                    "properties": {
                      "data": {
                        "type": "array",
                        "items": {
                          "$ref": "#/components/schemas/Contact"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
